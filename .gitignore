# Secrets and local state. Never commit these.
.env*
!.env.example
_auth/
.studio/
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.pyc

# Downloaded tools and caches
library/cache/
# Sound library: audio stays local (licences forbid sharing the files); only the contract and source list are committed
library/audio/*
!library/audio/CONTEXT.md
!library/audio/sources.json
tools/hyperframes/node_modules/
tools/iconanim/node_modules/
tools/earshot/

# Agent work folders
.worktrees/
.superpowers/
.impeccable/
.playwright-mcp/
design-system/

# Video outputs: big or generated files stay local
videos/*/*/01_voice/takes/
videos/*/*/00_research/pages/
videos/*/*/05_render/_segments/
videos/*/*/05_render/*.mp4
videos/*/*/05_render/check.md
videos/*/*/05_render/check-video.md
videos/*/*/05_render/listen.md
videos/*/*/05_render/benchmarks/
videos/*/*/05_render/review-rounds/

# Image previews with safe-area lines are rebuilt by `anim.py image export --guides`
images/*/*/03_export/preview/

# The demo video ships with the repo
# review frames are rebuilt by `anim.py stills` and the phone check; they stay local
videos/*/*/05_render/stills/
videos/*/*/05_render/sheets/
videos/*/*/05_render/phone/
videos/*/*/05_render/contact.png
videos/*/*/05_render/contact.html
# the demo MP4 is published as a GitHub Release asset, not in the repo

# Generated setup fixture output
tests/fixtures/silent-first-scene/05_render/*.mp4
tests/fixtures/silent-first-scene/05_render/*.render.json
tests/fixtures/silent-first-scene/05_render/check*.md
tests/fixtures/silent-first-scene/05_render/listen.md

# Look boards are generated by `anim.py looks board`; prefs.md stays tracked.
brands/*/looks/previews/
brands/*/looks/board.html
